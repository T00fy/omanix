#!/bin/bash

# omanix:summary=Regenerate the AI agent usage data files
# omanix:args=[--force] [--limits-only] [--except <agent>] [agent...]
# omanix:examples=omanix agent usage-update | omanix agent usage-update claude | omanix agent usage-update --except codex

# Each omanix-agent-usage-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/omanix/agents/usage/ where the
# agents panel watches them. Adding an agent is adding a collector — the
# panel picks up any record that appears here.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omanix/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omanix-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

# Collectors are wrapped commands on PATH, not files under a synthetic tree
# root (omanix has no $OMANIX_PATH/bin — D5). Iterate the known collector set
# and skip any that are not installed, so a subset build still works.
AGENTS=(claude codex fireworks)

pids=()
for agent in "${AGENTS[@]}"; do
  collector="omanix-agent-usage-$agent"
  command -v "$collector" >/dev/null 2>&1 || continue
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
